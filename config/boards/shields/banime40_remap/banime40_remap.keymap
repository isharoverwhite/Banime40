/*
 * banime40 ZMK Keymap
 * Converted from QMK default keymap (sporewoh/banime40)
 *
 * Layer index:
 *   0 = Base (QWERTY)
 *   1 = Num/Sym  (hold Space)
 *   2 = Fn/Media (hold Bksp)
 *   3 = Nav      (hold -)
 *   4 = Layer 4  (hold /)  — placeholder, define as needed
 *
 * TODO: Update keymap logic as directed by user.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ── Layer 0: Base ─────────────────────────────────────────────
         * ┌───┬───┬───┬───┬───┬───┬───┬───┬───┬───┐
         * │ Q │ W │ E │ R │ T │ Y │ U │ I │ O │ P │
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼───┤
         * │ A │ S │ D │ F │ G │ H │ J │ K │ L │ - │  (hold - = Nav)
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼───┤
         * │ Z │ X │ C │ V │ B │ N │ M │ , │ . │ / │  (hold / = L4)
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼───┤
         * │CTL│GUI│ALT│SFT│BSP│SPC│ENT│APP│DEL│ESC│  (hold BSP=Fn, hold SPC=Num)
         * └───┴───┴───┴───┴───┴───┴───┴───┴───┴───┘
         */
        base_layer {
            bindings = <
                &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y        &kp U     &kp I     &kp O     &kp P
                &kp A     &kp S     &kp D     &kp F     &kp G        &kp H        &kp J     &kp K     &kp L     &lt 3 MINUS
                &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N        &kp M     &kp COMMA &kp DOT   &lt 4 FSLH
                &kp LCTRL &kp LGUI  &kp LALT  &kp LSHFT &lt 2 BSPC  &lt 1 SPACE  &kp RET   &kp K_APP &kp DEL   &kp ESC
            >;
        };

        /* ── Base Layer — Bottom Row Variants (reference) ────────────
         *
         * [A] Full ortho (current, 10× 1u)
         *  ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┐
         *  │ CTL  │ GUI  │ ALT  │ SFT  │ BSP  │ SPC  │ ENT  │ APP  │ DEL  │ ESC  │
         *  │      │      │      │      │▼ FN  │▼ NUM │      │      │      │      │
         *  └──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┘
         *   3,0    3,1    3,2    3,3    3,4    3,5    3,6    3,7    3,8    3,9
         *
         * [B] 2×2.25u spacebar  — mất 3,3(SFT) và 3,6(ENT)
         *  ┌──────┬──────────┬──────┬────────────┬────────────┬──────┬──────┬──────┐
         *  │ CTL  │GUI/▼SFT  │ ALT  │─ BSP/▼FN ─│─ SPC/▼NUM─│ APP  │ DEL  │ ESC  │
         *  └──────┴──────────┴──────┴────────────┴────────────┴──────┴──────┴──────┘
         *   3,0       3,1      3,2       3,4           3,5      3,7    3,8    3,9
         *  Thay đổi:
         *   3,1 : &mt LSHFT LGUI   (tap=GUI, hold=Shift  — hấp thu SFT từ 3,3)
         *   3,4 : &lt 2 BSPC       (giữ nguyên)
         *   3,5 : &lt 1 SPACE      (giữ nguyên)
         *  Bổ sung vào layer:
         *   Num(1) 3,6 → &kp RET   (Enter bù cho 3,6 bị xóa)
         *
         * [C] 1×6.25u spacebar  — mất 3,2(ALT) 3,3(SFT) 3,5(SPC) 3,6(ENT) 3,7(APP)
         *  ┌──────┬──────────┬──────────────────────────┬──────────┬──────────┐
         *  │ CTL  │GUI/▼ALT  │──────── SPC/▼NUM ────────│ DEL/▼FN  │ ESC/▼SFT │
         *  └──────┴──────────┴──────────────────────────┴──────────┴──────────┘
         *   3,0       3,1                 3,4                 3,8        3,9
         *  Thay đổi:
         *   3,1 : &mt LALT LGUI    (tap=GUI, hold=ALT  — hấp thu ALT từ 3,2)
         *   3,4 : &lt 1 SPACE      (6.25u key = tap Space, hold Num)
         *   3,8 : &lt 2 DEL        (tap=DEL, hold=FN   — hấp thu FN trigger từ 3,4)
         *   3,9 : &mt LSHFT ESC    (tap=ESC, hold=Shift — hấp thu SFT từ 3,3)
         *  Bổ sung vào layer:
         *   Num(1) 3,4 → &kp BSPC  (Backspace bù cho tap 3,4 cũ)
         *   Num(1) 3,6 → &kp RET   (Enter bù cho 3,6 bị xóa)
         */

        /* ── Layer 1: Num / Sym ────────────────────────────────────────
         * ┌───┬───┬───┬───┬───┬───┬───┬───┬───┬───┐
         * │ 1 │ 2 │ 3 │ 4 │ 5 │ 6 │ 7 │ 8 │ 9 │ 0 │
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼───┤
         * │TAB│   │   │ ` │ [ │ ] │ \ │ ; │ ' │ - │
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼───┤
         * │   │   │   │   │ = │ - │   │   │   │   │
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼───┤
         * │   │   │   │   │   │▓▓▓│   │   │   │   │
         * └───┴───┴───┴───┴───┴───┴───┴───┴───┴───┘
         */
        num_sym_layer {
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6       &kp N7    &kp N8    &kp N9    &kp N0
                &kp TAB   &none     &none     &kp GRAVE &kp LBKT     &kp RBKT     &kp BSLH  &kp SEMI  &kp SQT   &kp MINUS
                &none     &none     &none     &none     &kp EQUAL    &kp MINUS    &none     &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans       &none        &trans    &trans    &trans    &trans
            >;
        };

        /* ── Layer 2: Fn / Media ───────────────────────────────────────
         * ┌───┬───┬───┬───┬───┬───┬───┬───┬───┬────┐
         * │F1 │F2 │F3 │F4 │F5 │F6 │F7 │F8 │F9 │F10 │
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼────┤
         * │TAB│F11│F12│   │   │   │   │   │   │    │
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼────┤
         * │CAP│PRT│SCL│PAU│   │NUM│   │VO-│VO+│MUTE│
         * ├───┼───┼───┼───┼───┼───┼───┼───┼───┼────┤
         * │   │   │   │   │▓▓▓│   │   │   │   │    │
         * └───┴───┴───┴───┴───┴───┴───┴───┴───┴────┘
         */
        fn_layer {
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp F6       &kp F7    &kp F8    &kp F9    &kp F10
                &kp TAB   &kp F11   &kp F12   &none     &none        &none        &none     &none     &none     &none
                &kp CAPS  &kp PSCRN &kp SLCK  &kp PAUSE_BREAK &none &kp KP_NUM   &none     &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
                &trans    &trans    &trans    &trans    &none        &none        &none     &none     &none     &none
            >;
        };

        /* ── Layer 3: Navigation ───────────────────────────────────────
         * ┌───┬───┬───┬───┬───┬───┬────┬───┬────┬───┐
         * │ESC│ ↑ │   │   │   │INS│PGUP│   │PGDN│DEL│
         * ├───┼───┼───┼───┼───┼───┼────┼───┼────┼───┤
         * │ ← │ ↓ │ → │TAB│   │HOM│    │   │    │   │
         * ├───┼───┼───┼───┼───┼───┼────┼───┼────┼───┤
         * │   │   │   │   │   │END│    │   │    │▓▓▓│  (hold = this layer)
         * ├───┼───┼───┼───┼───┼───┼────┼───┼────┼───┤
         * │   │   │   │   │BSP│   │    │   │    │   │
         * └───┴───┴───┴───┴───┴───┴────┴───┴────┴───┘
         * Arrow keys on WASD: W=↑  A=←  S=↓  D=→  TAB on F
         */
        nav_layer {
            bindings = <
                &kp ESC   &kp UP    &none     &none     &none        &kp INS      &kp PG_UP &none     &kp PG_DN &kp DEL
                &kp LEFT  &kp DOWN  &kp RIGHT &kp TAB   &none        &kp HOME     &none     &none     &none     &none
                &none     &none     &none     &none     &none        &kp END      &none     &none     &none     &trans
                &trans    &trans    &trans    &trans    &kp BSPC     &none        &none     &none     &none     &none
            >;
        };

        /* ── Layer 4: System / Connectivity ───────────────────────────
         * Activated by holding / (bottom-right alpha key)
         *
         * ┌────┬────┬────┬────┬────┬────┬────┬────┬────┬──────┐
         * │BT1 │BT2 │BT3 │BT4 │BT5 │    │    │    │    │BTCLR │
         * ├────┼────┼────┼────┼────┼────┼────┼────┼────┼──────┤
         * │    │    │    │    │    │    │USB │BLE │TOG │      │
         * ├────┼────┼────┼────┼────┼────┼────┼────┼────┼──────┤
         * │    │    │    │    │    │    │    │    │    │[hold]│
         * ├────┼────┼────┼────┼────┼────┼────┼────┼────┼──────┤
         * │    │    │    │    │    │    │    │    │    │      │
         * └────┴────┴────┴────┴────┴────┴────┴────┴────┴──────┘
         *
         * BT1-5        : Select Bluetooth profile 1-5 (paired device slots)
         * BTCLR        : Clear bonds on current BT profile (re-pair this slot)
         * USB          : Force USB HID output (manual override)
         * BLE          : Force BLE output (manual override — useful when charging via USB
         *                but wanting to use keyboard wirelessly at the same time)
         * TOG          : Toggle between USB and BLE output
         * STUDIO_UNLOCK: Unlock ZMK Studio for live keymap editing via web app
         *
         * Auto-switching (no key needed):
         *   - Plug into computer  → ZMK detects USB enumeration → routes to USB automatically
         *   - Plug into charger   → USB not enumerated → BLE stays active automatically
         *   - Unplug              → BLE active automatically
         *
         * ZMK Studio live remap:
         *   1. Plug in USB cable
         *   2. Open Banime40-remap web app → click "Connect" → select the port
         *   3. Hold / to activate Layer 4, then tap Y (&studio_unlock)
         *   4. Web app shows "⚡ Live" — edit keys, click "Apply live"
         */
        sys_layer {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock  &none         &none         &none        &bt BT_CLR
                &none           &none         &none         &none         &none         &none  &out OUT_USB  &out OUT_BLE  &out OUT_TOG &none
                &none           &none         &none         &none         &none         &none  &none         &none         &none        &trans
                &none           &none         &none         &none         &none         &none  &none         &none         &none        &none
            >;
        };
    };
};
